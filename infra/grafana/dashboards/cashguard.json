{
  "title": "CashGuard Trader",
  "uid": "cashguard-main",
  "tags": ["trading", "cashguard"],
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Kill Switch Status",
      "description": "Saved global control. Missing data is UNKNOWN; check safety read/unknown controls below. This does not prove positions are flat.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "INACTIVE", "color": "green" }, "1": { "text": "ACTIVE", "color": "red" } } },
            { "type": "special", "options": { "match": "null+nan", "result": { "text": "UNKNOWN", "color": "gray" } } }
          ],
          "thresholds": { "steps": [{ "color": "gray", "value": null }, { "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [{ "expr": "cashguard_kill_switch_active{job=\"cashguard_api\"}", "legendFormat": "{{instance}}", "instant": true, "range": false }]
    },
    {
      "id": 2,
      "title": "Available Cash",
      "type": "text",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "mode": "markdown", "content": "**UNAVAILABLE**\n\nAccount cash is not exported: no authoritative account/freshness producer is wired. Use the [operator view](/app/operator)." }
    },
    {
      "id": 3,
      "title": "Account Total Value",
      "type": "text",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "mode": "markdown", "content": "**UNAVAILABLE**\n\nAccount value is not exported. No account-wide value or currency is inferred from missing telemetry. Use the [operator view](/app/operator)." }
    },
    {
      "id": 4,
      "title": "Open Positions",
      "type": "text",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "mode": "markdown", "content": "**UNAVAILABLE**\n\nOpen-position counts are not exported. Missing data does not mean zero positions. Use the [operator view](/app/operator)." }
    },
    {
      "id": 5,
      "title": "Auto Trading Enabled",
      "description": "Saved global setting; disabled may be intentional. Missing data is UNKNOWN, never permission to trade.",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISABLED", "color": "orange" }, "1": { "text": "ENABLED", "color": "green" } } },
            { "type": "special", "options": { "match": "null+nan", "result": { "text": "UNKNOWN", "color": "gray" } } }
          ],
          "thresholds": { "steps": [{ "color": "gray", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [{ "expr": "cashguard_auto_trading_enabled{job=\"cashguard_api\"}", "legendFormat": "{{instance}}", "instant": true, "range": false }]
    },
    {
      "id": 6,
      "title": "Orders Placed (last 1h)",
      "type": "graph",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(cashguard_orders_placed_total[5m])", "legendFormat": "{{side}} {{status}}" }
      ]
    },
    {
      "id": 7,
      "title": "Risk Violations Rate",
      "type": "graph",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(cashguard_risk_violations_total[5m])", "legendFormat": "{{violation_type}}" }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "orange" } } }
    },
    {
      "id": 8,
      "title": "Cash Guard Blocks (cumulative)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "red" } } },
      "targets": [{ "expr": "cashguard_cash_guard_blocks_total", "legendFormat": "Cash Guard Blocks" }]
    },
    {
      "id": 9,
      "title": "Latest recorded global activation",
      "description": "Retained global event time, not an activation count or current halt. No value can mean no retained event or an unreadable state; check safety read/unknown controls. Resolution never means trading resumed.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso", "noValue": "NO RETAINED EVENT OR UNKNOWN" } },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "none" },
      "targets": [{ "expr": "cashguard_kill_switch_last_activation_timestamp_seconds{job=\"cashguard_api\"} * 1000", "legendFormat": "{{instance}}", "instant": true, "range": false }]
    },
    {
      "id": 10,
      "title": "Broker API Latency (p95)",
      "type": "graph",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(cashguard_broker_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 {{endpoint}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 11,
      "title": "Signals Generated",
      "type": "graph",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "increase(cashguard_signals_generated_total[1h])", "legendFormat": "{{strategy_type}} {{side}} live={{is_live}}" }
      ]
    },
    {
      "id": 12,
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": { "x": 12, "y": 20, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED (OK)", "color": "green" }, "1": { "text": "OPEN (FAILING)", "color": "red" } } }
          ]
        }
      },
      "targets": [{ "expr": "cashguard_circuit_breaker_open", "legendFormat": "{{name}}" }]
    },
    {
      "id": 13,
      "title": "Safety state read",
      "description": "READ OK only describes the database read. Individual controls may still be unknown; see the adjacent table. NO DATA is unavailable, not healthy.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "noValue": "UNKNOWN", "mappings": [{ "type": "value", "options": { "0": { "text": "UNREADABLE", "color": "red" }, "1": { "text": "READ OK", "color": "blue" } } }], "thresholds": { "steps": [{ "color": "gray", "value": null }] } } },
      "options": { "reduceOptions": { "calcs": ["last"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [{ "expr": "cashguard_safety_state_read_ok{job=\"cashguard_api\"}", "legendFormat": "{{instance}}", "instant": true, "range": false }]
    },
    {
      "id": 14,
      "title": "Unknown saved controls",
      "description": "Present rows identify controls whose saved values are unknown. An unused venue may intentionally be unconfigured; do not enable it to clear this view. An empty table alone is not proof of healthy telemetry; inspect Safety state read and target availability.",
      "type": "table",
      "gridPos": { "x": 6, "y": 24, "w": 18, "h": 4 },
      "fieldConfig": { "defaults": { "noValue": "UNKNOWN" } },
      "targets": [{ "expr": "cashguard_safety_state_known{job=\"cashguard_api\"} == 0", "format": "table", "instant": true, "range": false }]
    }
  ]
}
